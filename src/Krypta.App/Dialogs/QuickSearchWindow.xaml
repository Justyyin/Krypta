<Window x:Class="Krypta.App.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Krypta" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="16">
        <TextBox x:Name="QueryBox" FontSize="16" TextChanged="Query_Changed" PreviewKeyDown="Query_KeyDown"
                 AutomationProperties.Name="{DynamicResource List.Search}" />
        <ListBox x:Name="ResultList" Margin="0,8,0,0" MaxHeight="264" MouseDoubleClick="Result_DoubleClick"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Quick.Hint}" Margin="0,8,0,0" />
    </StackPanel>
</Window>
