<Window x:Class="Krypta.App.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource History.Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource History.Hint}" />
        <ListBox x:Name="PasswordList" Margin="0,12,0,0" MaxHeight="320" FontFamily="{StaticResource MonoFont}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Detail.Copy}" MinWidth="100" Click="Copy_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Common.Close}" IsCancel="True" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
