<Window x:Class="Krypta.App.PasskeyPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Passkey.Title}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Topmost="True">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="26" VerticalAlignment="Top" Margin="0,2,14,0"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="15" Width="370" />
        </StackPanel>
        <ListBox x:Name="AccountList" Margin="0,14,0,0" MaxHeight="180" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ConfirmButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="120" Click="Confirm_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Passkey.UseBrowser}" IsCancel="True" MinWidth="120" />
        </StackPanel>
    </StackPanel>
</Window>
