<Window x:Class="Krypta.App.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Welcome.Title}" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource LogoImage}" Width="44" Height="44" />
            <TextBlock Text="{DynamicResource Welcome.Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Welcome.Step1}" TextWrapping="Wrap" Margin="0,18,0,0" />
        <TextBlock Text="{DynamicResource Welcome.Step2}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock Text="{DynamicResource Welcome.Step3}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{DynamicResource Welcome.OpenSettings}" Style="{DynamicResource AccentButtonStyle}" Click="Settings_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Common.Close}" IsCancel="True" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
