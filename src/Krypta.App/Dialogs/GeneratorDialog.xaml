<Window x:Class="Krypta.App.GeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Gen.Title}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <Border Padding="14,12" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="PasswordText" FontFamily="{StaticResource MonoFont}" FontSize="18" TextWrapping="Wrap" MinHeight="48" />
        </Border>
        <TextBlock x:Name="EntropyText" Style="{StaticResource Hint}" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Click="Regenerate_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource Gen.Regenerate}" />
                </StackPanel>
            </Button>
            <Button Content="{DynamicResource Detail.Copy}" Click="Copy_Click" />
        </StackPanel>
        <TextBlock x:Name="CopiedText" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed" />

        <TextBlock x:Name="LengthLabel" Style="{StaticResource FieldLabel}" />
        <Slider x:Name="LengthSlider" Minimum="8" Maximum="64" Value="20" IsSnapToTickEnabled="True" TickFrequency="1"
                ValueChanged="Option_Changed" />

        <CheckBox x:Name="UpperCheck" IsChecked="True" Content="{DynamicResource Gen.Upper}" Margin="0,10,0,0" Click="Option_Changed" />
        <CheckBox x:Name="LowerCheck" IsChecked="True" Content="{DynamicResource Gen.Lower}" Click="Option_Changed" />
        <CheckBox x:Name="DigitsCheck" IsChecked="True" Content="{DynamicResource Gen.Digits}" Click="Option_Changed" />
        <CheckBox x:Name="SymbolsCheck" IsChecked="True" Content="{DynamicResource Gen.Symbols}" Click="Option_Changed" />
        <CheckBox x:Name="AmbiguousCheck" Content="{DynamicResource Gen.NoAmbiguous}" Click="Option_Changed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="UseButton" Content="{DynamicResource Gen.Use}" Style="{DynamicResource AccentButtonStyle}"
                    IsDefault="True" Click="Use_Click" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" IsCancel="True" MinWidth="100" />
        </StackPanel>
    </StackPanel>
</Window>
