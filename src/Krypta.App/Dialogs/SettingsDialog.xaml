<Window x:Class="Krypta.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}" Width="540" SizeToContent="Height" MaxHeight="700" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,8,24,20">
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.Language}" />
        <ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed" HorizontalAlignment="Left" MinWidth="220" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.Theme}" />
        <ComboBox x:Name="ThemeBox" SelectionChanged="Appearance_Changed" HorizontalAlignment="Left" MinWidth="220" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.Accent}" />
        <ComboBox x:Name="AccentBox" SelectionChanged="Appearance_Changed" HorizontalAlignment="Left" MinWidth="220" />

        <CheckBox x:Name="IconsCheck" Margin="0,12,0,0" Click="Option_Changed">
            <TextBlock Text="{DynamicResource Settings.Favicons}" TextWrapping="Wrap" />
        </CheckBox>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Security}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.AutoLock}" />
        <ComboBox x:Name="AutoLockBox" SelectionChanged="AutoLock_Changed" HorizontalAlignment="Left" MinWidth="220" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.Clipboard}" />
        <ComboBox x:Name="ClipboardBox" SelectionChanged="Clipboard_Changed" HorizontalAlignment="Left" MinWidth="220" />
        <CheckBox x:Name="CaptureCheck" Margin="0,12,0,0" Click="Capture_Changed">
            <TextBlock Text="{DynamicResource Settings.BlockCapture}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox x:Name="MinimizeCheck" Click="Option_Changed">
            <TextBlock Text="{DynamicResource Settings.LockOnMinimize}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox x:Name="TrayCheck" Click="Option_Changed">
            <TextBlock Text="{DynamicResource Settings.CloseToTray}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox x:Name="MonitorCheck" Click="Option_Changed">
            <TextBlock Text="{DynamicResource Settings.LeakMonitor}" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Settings.Hotkeys}" Margin="0,6,0,0" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Device.Title}" />
        <TextBlock x:Name="DeviceText" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Unlock.BindDeviceHint}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.Device.Confirm}" />
        <PasswordBox x:Name="DevicePassword" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="DeviceButton" Click="Device_Click" MinWidth="150" Margin="0,0,8,0" />
            <Button x:Name="RecoveryButton" Content="{DynamicResource Settings.Device.ShowKey}" Click="ShowRecovery_Click" />
        </StackPanel>
        <TextBlock x:Name="KeyFileText" Margin="0,14,0,0" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Unlock.KeyFileHint}" />
        <Button x:Name="KeyFileButton" Click="KeyFile_Click" HorizontalAlignment="Left" MinWidth="150" Margin="0,8,0,0" />
        <TextBlock x:Name="DeviceStatus" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Data.Title}" />
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Data.BackupHint}" />
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Data.ImportHint}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{DynamicResource Data.Backup}" Click="Backup_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Data.Import}" Click="Import_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Data.Export}" Click="Export_Click" />
        </StackPanel>
        <TextBlock x:Name="DataStatus" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Browser}" />
        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Settings.BrowserHint}" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BrowserButton" Click="Browser_Click" MinWidth="150" />
            <TextBlock x:Name="BrowserStatus" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.ChangePassword}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.Current}" />
        <PasswordBox x:Name="CurrentPassword" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings.New}" />
        <PasswordBox x:Name="NewPassword" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Unlock.Confirm}" />
        <PasswordBox x:Name="ConfirmPassword" />
        <TextBlock x:Name="PasswordStatus" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <Button x:Name="ChangeButton" Content="{DynamicResource Settings.Change}" Click="ChangePassword_Click"
                HorizontalAlignment="Left" MinWidth="150" Margin="0,12,0,0" />

        <Button Content="{DynamicResource Common.Close}" IsCancel="True" HorizontalAlignment="Right" MinWidth="100" Margin="0,16,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>
