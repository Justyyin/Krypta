<Window x:Class="Krypta.App.DisplayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="CaptionText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,14" />
        <Border x:Name="QrFrame" Background="White" Padding="14" HorizontalAlignment="Center" CornerRadius="8" Visibility="Collapsed">
            <Image x:Name="QrImage" Width="280" Height="280" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
        <TextBlock x:Name="LargeText" FontFamily="{StaticResource MonoFont}" FontSize="34" TextWrapping="Wrap"
                   LineHeight="48" Visibility="Collapsed" />
        <Button Content="{DynamicResource Common.Close}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="100" Margin="0,18,0,0" />
    </StackPanel>
</Window>
