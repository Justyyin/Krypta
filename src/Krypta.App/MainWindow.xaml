<Window x:Class="Krypta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Krypta" Icon="/Krypta;component/Resources/krypta.ico" Width="1100" Height="700" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Locked: unlock or create a vault -->
        <Grid x:Name="UnlockPanel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24">
                    <Image Source="{StaticResource LogoImage}" Width="64" Height="64" HorizontalAlignment="Center" />
                    <TextBlock Text="Krypta" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="UnlockSubtitle" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75" Margin="0,6,0,10" />

                    <Border x:Name="PasskeyBanner" Visibility="Collapsed" Padding="12,10" CornerRadius="6" Margin="0,4,0,0"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" BorderThickness="1">
                        <TextBlock Text="{DynamicResource Unlock.PasskeyWaiting}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Unlock.MasterPassword}" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_Changed" />

                    <StackPanel x:Name="CreateFields">
                        <ProgressBar x:Name="StrengthBar" Maximum="4" Height="4" Margin="0,8,0,0" />
                        <TextBlock x:Name="StrengthText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Unlock.Confirm}" />
                        <PasswordBox x:Name="ConfirmInput" />
                        <CheckBox x:Name="DeviceBindCheck" Margin="0,14,0,0">
                            <TextBlock Text="{DynamicResource Unlock.BindDevice}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="DeviceBindHint" Style="{StaticResource Hint}" Margin="28,0,0,0" />
                        <CheckBox x:Name="KeyFileCheck" Margin="0,10,0,0">
                            <TextBlock Text="{DynamicResource Unlock.UseKeyFile}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0" Text="{DynamicResource Unlock.KeyFileHint}" />
                    </StackPanel>

                    <StackPanel x:Name="KeyFileFields" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Unlock.KeyFile}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Unlock.KeyFileChoose}" Click="ChooseKeyFile_Click" Margin="8,0,0,0" />
                            <TextBlock x:Name="KeyFileText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="RecoveryFields" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" Text="{DynamicResource Unlock.RecoveryHint}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Unlock.RecoveryKey}" />
                        <TextBox x:Name="RecoveryInput" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="UnlockError" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Button x:Name="UnlockButton" Style="{DynamicResource AccentButtonStyle}" IsDefault="True"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="UnlockButton_Click" />
                    <ProgressBar x:Name="UnlockProgress" IsIndeterminate="True" Visibility="Hidden" Height="4" Margin="0,8,0,0" />

                    <ComboBox x:Name="VaultBox" HorizontalAlignment="Stretch" Margin="0,14,0,0" Visibility="Collapsed"
                              SelectionChanged="VaultBox_SelectionChanged" />
                    <TextBlock x:Name="VaultPathText" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="{DynamicResource Unlock.OpenOther}" Click="OpenOther_Click" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Unlock.CreateNew}" Click="CreateNew_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
                <Button Content="Deutsch" Click="LanguageDe_Click" Margin="0,0,6,0" />
                <Button Content="English" Click="LanguageEn_Click" />
            </StackPanel>
        </Grid>

        <!-- Unlocked -->
        <Grid x:Name="VaultPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,16">
                        <Image Source="{StaticResource LogoImage}" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Text="Krypta" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Generator_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Generator}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="Settings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Settings}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Lock_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Lock}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Tag="all">
                            <DockPanel>
                                <TextBlock x:Name="CountAll" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.All}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="favorites">
                            <DockPanel>
                                <TextBlock x:Name="CountFavorites" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Favorites}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="passwords">
                            <DockPanel>
                                <TextBlock x:Name="CountPasswords" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Passwords}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="passkeys">
                            <DockPanel>
                                <TextBlock x:Name="CountPasskeys" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Passkeys}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="authenticator">
                            <DockPanel>
                                <TextBlock x:Name="CountCodes" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Authenticator}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="notes">
                            <DockPanel>
                                <TextBlock x:Name="CountNotes" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Notes}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="cards">
                            <DockPanel>
                                <TextBlock x:Name="CountCards" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Cards}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="wifi">
                            <DockPanel>
                                <TextBlock x:Name="CountWifi" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Wifi}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="security">
                            <DockPanel>
                                <TextBlock x:Name="CountSecurity" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Security}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="trash">
                            <DockPanel>
                                <TextBlock x:Name="CountTrash" DockPanel.Dock="Right" Opacity="0.6" Margin="8,0,0,0" />
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Trash}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="credits">
                            <DockPanel>
                                
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Nav.Credits}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Entry list -->
            <DockPanel x:Name="ListColumn" Grid.Column="1" Margin="12,12,6,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Opacity="0.7" Margin="4,0,8,0"
                               ToolTip="{DynamicResource List.Search}" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged"
                             AutomationProperties.Name="{DynamicResource List.Search}" />
                    <Button Grid.Column="2" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" Click="NewEntry_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource List.New}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ComboBox x:Name="WebsiteBox" DockPanel.Dock="Top" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                          SelectionChanged="WebsiteBox_SelectionChanged" AutomationProperties.Name="{DynamicResource Detail.Website}" />
                <TextBlock x:Name="EmptyListText" DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="13" Margin="6,16,6,0" Visibility="Collapsed" />
                <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="EntryList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="10,10,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34" Margin="0,0,12,0">
                                    <Border CornerRadius="8" Background="{Binding AvatarBrush}">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="8" Background="White" Visibility="{Binding IconVisibility}">
                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Code}" FontFamily="{StaticResource MonoFont}" FontSize="15" VerticalAlignment="Center" />
                                    <Border Visibility="{Binding PasskeyVisibility}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                            BorderThickness="1" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                        <TextBlock Text="Passkey" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Details -->
            <Border x:Name="DetailColumn" Grid.Column="2" Margin="6,12,12,12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Text="{DynamicResource Detail.None}" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="28,22,28,24">
                            <DockPanel>
                                <Button x:Name="FavoriteButton" DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" FontSize="16"
                                        VerticalAlignment="Top" Click="Favorite_Click" ToolTip="{DynamicResource Detail.Favorite}"
                                        AutomationProperties.Name="{DynamicResource Detail.Favorite}" />
                                <TextBlock x:Name="DetailTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock x:Name="DetailModified" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            <TextBlock x:Name="DetailTags" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            <TextBlock x:Name="TrashInfo" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                            <StackPanel x:Name="UsernameRow">
                                <TextBlock x:Name="UsernameLabel" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource Detail.Copy}" Click="CopyUsername_Click" Margin="8,0,0,0" />
                                    <TextBlock x:Name="DetailUsername" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="15" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel x:Name="PasswordRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Detail.Password}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource Detail.Copy}" Click="CopyPassword_Click" Margin="8,0,0,0" />
                                    <Button x:Name="ShowPasswordButton" DockPanel.Dock="Right" Click="ShowPassword_Click" Margin="8,0,0,0" />
                                    <Button x:Name="HistoryButton" DockPanel.Dock="Right" Click="History_Click" Margin="8,0,0,0" />
                                    <TextBlock x:Name="DetailPassword" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="15"
                                               FontFamily="{StaticResource MonoFont}" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{DynamicResource Detail.Type}" Click="AutoType_Click" Margin="0,0,8,0" />
                                    <Button Content="{DynamicResource Detail.Large}" Click="LargeView_Click" Margin="0,0,8,0" />
                                    <Button x:Name="WifiQrButton" Content="{DynamicResource Detail.ShowQr}" Click="WifiQr_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="WebsiteRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Detail.Website}" />
                                <DockPanel>
                                    <Button x:Name="OpenWebsiteButton" DockPanel.Dock="Right" Content="{DynamicResource Detail.Open}" Click="OpenWebsite_Click" Margin="8,0,0,0" />
                                    <TextBlock x:Name="DetailWebsite" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="15" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel x:Name="CodeRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Detail.Code}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource Detail.Copy}" Click="CopyCode_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource Detail.ShowQr}" Click="TotpQr_Click" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetailCodeSeconds" DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.7" Margin="8,0,0,0" />
                                    <TextBlock x:Name="DetailCode" FontSize="30" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DockPanel>
                                <ProgressBar x:Name="DetailCodeProgress" Height="4" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="CardNumberRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Card.Number}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource Detail.Copy}" Click="CopyCardNumber_Click" Margin="8,0,0,0" />
                                    <Button x:Name="ShowCardButton" DockPanel.Dock="Right" Click="ShowPassword_Click" Margin="8,0,0,0" />
                                    <TextBlock x:Name="DetailCardNumber" VerticalAlignment="Center" FontSize="15" FontFamily="{StaticResource MonoFont}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel x:Name="CardExpiryRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Card.Expiry}" />
                                <TextBlock x:Name="DetailCardExpiry" FontSize="15" />
                            </StackPanel>
                            <StackPanel x:Name="CardCodeRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Card.Code}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource Detail.Copy}" Click="CopyCardCode_Click" Margin="8,0,0,0" />
                                    <TextBlock x:Name="DetailCardCode" VerticalAlignment="Center" FontSize="15" FontFamily="{StaticResource MonoFont}" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel x:Name="PasskeyRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Detail.Passkey}" />
                                <TextBlock x:Name="DetailPasskey" TextWrapping="Wrap" FontSize="15" />
                            </StackPanel>

                            <StackPanel x:Name="NotesRow">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Detail.Notes}" />
                                <TextBlock x:Name="DetailNotes" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                                <Button x:Name="EditButton" Content="{DynamicResource Detail.Edit}" Click="EditEntry_Click" MinWidth="96" Margin="0,0,8,0" />
                                <Button x:Name="DeleteButton" Content="{DynamicResource Detail.Delete}" Click="DeleteEntry_Click" MinWidth="96" />
                                <Button x:Name="RestoreButton" Content="{DynamicResource Detail.Restore}" Click="RestoreEntry_Click" MinWidth="96" Margin="0,0,8,0" />
                                <Button x:Name="PurgeButton" Content="{DynamicResource Detail.DeleteForever}" Click="PurgeEntry_Click" MinWidth="96" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Security check -->
            <ScrollViewer x:Name="SecurityPage" Grid.Column="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,24,32,32" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource Nav.Security}" FontSize="26" FontWeight="SemiBold" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Sec.Passwords}" />
                    <TextBlock x:Name="SecuritySummary" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Sec.LeakHint}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CheckLeaksButton" Style="{DynamicResource AccentButtonStyle}" Content="{DynamicResource Sec.CheckLeaks}" Click="CheckLeaks_Click" />
                        <TextBlock x:Name="LeakStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="FindingList" Margin="0,12,0,0" MaxHeight="260" HorizontalContentAlignment="Stretch"
                             SelectionChanged="FindingList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Opacity="0.8" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Sec.Email}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Sec.EmailHint}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Sec.EmailAddress}" />
                    <ComboBox x:Name="EmailBox" IsEditable="True" HorizontalAlignment="Left" Width="360" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Sec.ApiKey}" />
                    <PasswordBox x:Name="ApiKeyBox" HorizontalAlignment="Left" Width="360" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CheckEmailButton" Style="{DynamicResource AccentButtonStyle}" Content="{DynamicResource Sec.CheckEmail}" MinWidth="100" Click="CheckEmail_Click" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Sec.OpenHibp}" Click="OpenHibp_Click" />
                    </StackPanel>
                    <TextBlock x:Name="EmailResult" TextWrapping="Wrap" FontSize="15" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Credits -->
            <ScrollViewer x:Name="CreditsPage" Grid.Column="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,24,32,32" MaxWidth="700" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource LogoImage}" Width="56" Height="56" />
                        <TextBlock Text="Krypta" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="CreditsAbout" TextWrapping="Wrap" FontSize="15" Margin="0,16,0,0" />
                    <TextBlock Text="{DynamicResource Credits.Contributors}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="justyin-dev.de" Click="CreatorWebsite_Click" Margin="0,0,14,0" />
                        <TextBlock Text="Discord: jsyxn" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Credits.License}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{DynamicResource Credits.Audit}" TextWrapping="Wrap" Margin="0,10,0,0" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Credits.BuiltWith}" />
                    <TextBlock Margin="0,6,0,0" LineHeight="22" TextWrapping="Wrap">
                        .NET and WPF (Microsoft, MIT)<LineBreak />
                        Konscious.Security.Cryptography.Argon2 (MIT)<LineBreak />
                        ZXing.Net (Apache 2.0)<LineBreak />
                        System.Formats.Cbor (Microsoft, MIT)
                    </TextBlock>
                    <TextBlock Text="{DynamicResource Credits.Hibp}" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Short confirmation message -->
            <Border x:Name="Toast" Grid.ColumnSpan="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24" Padding="16,10" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock x:Name="ToastText" />
            </Border>
        </Grid>
    </Grid>
</Window>
